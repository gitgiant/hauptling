{
  "_doc": "Shipped default. prefer (cheap|balanced|best) caps the tier workers may use (1|2|3; spawn --allow-tier overrides). effort: default reasoning effort per tier, passed via each vendor's effortArgs (a model entry's own effort wins; spawn --effort overrides; agy has none: its model ids carry the effort). Workers load no user MCP servers (Claude: the per-agent managed-mcp.json, see src/codegraph.mjs; Codex -c mcp_servers={}). Override any part in ~/.hauptling/models.json (deep-merged). tier: 1 cheap, 2 mid, 3 top. Prices are USD per million tokens; null means unknown (cost shows as unknown). Codex keeps its workspace-write sandbox (network on so it reaches the broker); it cannot write .git, so hauptling commits for it on report/test request. Workers run in disposable containers with an egress allowlist; the container is the sandbox (Codex's own bubblewrap sandbox cannot run inside Docker, so Codex uses danger-full-access there, chosen 2026-11-21).",
  "prefer": "best",
  "effort": {
    "1": "low",
    "2": "medium",
    "3": "high"
  },
  "rules": {
    "easy": 1,
    "normal": 2,
    "hard": 3
  },
  "order": [
    "claude",
    "codex",
    "agy"
  ],
  "vendors": {
    "claude": {
      "enabled": true,
      "launch": [
        "claude",
        "--model",
        "{model}",
        "--permission-mode",
        "auto",
        "{prompt}"
      ],
      "effortArgs": [
        "--effort",
        "{effort}"
      ],
      "models": [
        {
          "id": "haiku-5-5",
          "model": "claude-haiku-5-5",
          "tier": 1,
          "usd_in": 0.1,
          "usd_out": 0.5
        },
        {
          "id": "sonnet-5-5",
          "model": "claude-sonnet-5-5",
          "tier": 2,
          "usd_in": 2,
          "usd_out": 10
        },
        {
          "id": "opus-5-5",
          "model": "claude-opus-5-5",
          "tier": 3,
          "usd_in": 4,
          "usd_out": 20
        },
        {
          "id": "fable-5-2",
          "model": "claude-fable-5-2",
          "tier": 3,
          "usd_in": 8,
          "usd_out": 40
        }
      ]
    },
    "codex": {
      "enabled": true,
      "launch": [
        "codex",
        "--model",
        "{model}",
        "--sandbox",
        "danger-full-access",
        "--ask-for-approval",
        "never",
        "-c",
        "mcp_servers={}",
        "--no-alt-screen",
        "{prompt}"
      ],
      "effortArgs": [
        "-c",
        "model_reasoning_effort=\"{effort}\""
      ],
      "models": [
        {
          "id": "gpt-6-luna",
          "model": "gpt-6-luna",
          "tier": 1,
          "usd_in": 0.1,
          "usd_out": 0.5,
          "notes": "fast, easier tasks"
        },
        {
          "id": "gpt-6.2-sol",
          "model": "gpt-6.2-sol",
          "tier": 2,
          "usd_in": 2,
          "usd_out": 10,
          "notes": "go-to for coding"
        },
        {
          "id": "gpt-6.2-astra",
          "model": "gpt-6.2-astra",
          "tier": 3,
          "usd_in": 8,
          "usd_out": 40,
          "notes": "most capable"
        }
      ]
    },
    "agy": {
      "enabled": true,
      "launch": [
        "agy",
        "--model",
        "{model}",
        "--mode",
        "auto",
        "-i",
        "{prompt}"
      ],
      "models": [
        {
          "id": "gemini-3.8-flash-medium",
          "model": "gemini-3.8-flash-medium",
          "tier": 1,
          "usd_in": 0.75,
          "usd_out": 3.75
        },
        {
          "id": "gemini-4-neon-medium",
          "model": "gemini-4-neon-medium",
          "tier": 2,
          "usd_in": 3,
          "usd_out": 15
        },
        {
          "id": "gemini-4-neon-high",
          "model": "gemini-4-neon-high",
          "tier": 3,
          "usd_in": 3,
          "usd_out": 15
        }
      ]
    }
  }
}
